# Copy to .env and fill in real values. Committed as reference only.
# Local connection defaults use admin / localhost; schema adoption is explicit.
# Empty Compose data directories provision ta7ady on first initialization only.
# Existing database/schema approval is still required: docs/DATABASE_MIGRATIONS.md.
# POSTGRES_USER must match SPRING_DATASOURCE_USERNAME (app + migration owner).
# PGDATA is deliberately unset: inspect existing storage before selecting it.
# Confirmed fresh dev database: PGDATA=/data/postgres
# Confirmed fresh production database: PGDATA=/var/lib/postgresql/data
ADMIN_PASSWORD=changeme
# Optional when the local frontend uses another port; exact origins, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:4200
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ta7ady
SPRING_DATASOURCE_USERNAME=username
SPRING_DATASOURCE_PASSWORD=changeme
POSTGRES_USER=username
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ta7ady
